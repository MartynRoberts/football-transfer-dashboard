generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id              String  @id
  transfermarktId String? @unique

  name    String
  country String?

  clubs Club[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id              String  @id
  transfermarktId String? @unique

  name    String
  slug    String  @unique
  logoUrl String?

  leagueId String
  league   League @relation(fields: [leagueId], references: [id])

  players Player[]

  incomingTransfers Transfer[] @relation("IncomingTransfers")
  outgoingTransfers Transfer[] @relation("OutgoingTransfers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
}

model Player {
  id              String  @id
  transfermarktId String? @unique

  name        String
  position    String?
  nationality String?
  dateOfBirth DateTime?

  currentClubId String?
  currentClub   Club?   @relation(fields: [currentClubId], references: [id])

  transfers    Transfer[]
  marketValues MarketValue[]
  injuries     Injury[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentClubId])
}

model Season {
  id        String @id
  name      String
  startYear Int
  endYear   Int

  transfers Transfer[]

  createdAt DateTime @default(now())
}

model Transfer {
  id String @id

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  fromClubId String?
  fromClub   Club?   @relation("OutgoingTransfers", fields: [fromClubId], references: [id])

  toClubId String?
  toClub   Club?   @relation("IncomingTransfers", fields: [toClubId], references: [id])

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  fee          Int?
  transferDate DateTime?
  transferType String?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
  @@index([seasonId])
}

model MarketValue {
  id String @id

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  value      Int
  capturedAt DateTime @default(now())

  @@index([playerId])
  @@index([capturedAt])
}

model Injury {
  id String @id

  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  description    String?
  startDate      DateTime?
  expectedReturn DateTime?

  createdAt DateTime @default(now())

  @@index([playerId])
}

model SyncLog {
  id String @id @default(cuid())

  type   String
  status String

  records Int?
  error   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
}
