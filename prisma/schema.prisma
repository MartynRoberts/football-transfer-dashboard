generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id              String   @id
  transfermarktId String   @unique

  name            String
  country         String?

  clubs           Club[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Club {
  id                String   @id
  transfermarktId   String   @unique

  name              String

  leagueId          String?
  league            League?  @relation(fields: [leagueId], references: [id])

  players           Player[]

  outgoingTransfers Transfer[] @relation("OutgoingTransfers")
  incomingTransfers Transfer[] @relation("IncomingTransfers")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Player {
  id                String   @id
  transfermarktId   String   @unique

  name              String
  position          String?
  dateOfBirth       DateTime?
  nationality       String?
  foot              String?

  marketValue       Int?

  currentClubId     String?
  currentClub       Club?    @relation(fields: [currentClubId], references: [id])

  transfers         Transfer[]

  injuries          Injury[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Transfer {
  id              String   @id

  playerId        String
  player          Player   @relation(fields: [playerId], references: [id])

  fromClubId      String?
  fromClub        Club?    @relation("OutgoingTransfers", fields: [fromClubId], references: [id])

  toClubId        String?
  toClub          Club?    @relation("IncomingTransfers", fields: [toClubId], references: [id])

  date            DateTime?
  upcoming        Boolean  @default(false)

  season          String?

  marketValue     Int?
  fee             Int?

  createdAt       DateTime @default(now())
}

model Injury {
  id              String   @id

  playerId        String
  player          Player   @relation(fields: [playerId], references: [id])

  injury          String?
  startDate       DateTime?
  endDate         DateTime?

  createdAt       DateTime @default(now())
}

model SyncLog {
  id              String   @id @default(cuid())

  type            String
  status          String

  startedAt       DateTime @default(now())
  completedAt     DateTime?

  recordsCreated  Int      @default(0)
  recordsUpdated  Int      @default(0)

  errorMessage    String?
}