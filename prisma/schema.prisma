generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id        String   @id
  name      String
  country   String?

  clubs     Club[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id                String @id
  transfermarktId   String @unique

  name              String

  players           Player[]

  outgoingTransfers Transfer[] @relation("OutgoingTransfers")
  incomingTransfers Transfer[] @relation("IncomingTransfers")

  leagueId          String?
  league            League? @relation(
    fields: [leagueId],
    references: [id]
  )

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Player {
  id              String   @id
  transfermarktId String   @unique

  name            String
  position        String?
  dateOfBirth     DateTime?
  nationality     String?
  foot            String?

  marketValue     Int?

  currentClubId   String?
  currentClub     Club? @relation(
    fields: [currentClubId],
    references: [id]
  )

  transfers       Transfer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Season {
  id        String @id
  name      String
  startYear Int
  endYear   Int

  transfers Transfer[]

  createdAt DateTime @default(now())
}

model Transfer {
  id            String   @id

  playerId      String
  fromClubId    String?
  toClubId      String?

  seasonId      String

  fee           Int?
  transferDate  DateTime?
  transferType  String?

  player        Player @relation(fields: [playerId], references: [id])

  fromClub      Club? @relation("OutgoingTransfers", fields: [fromClubId], references: [id])

  toClub        Club? @relation("IncomingTransfers", fields: [toClubId], references: [id])

  season        Season @relation(fields: [seasonId], references: [id])

  createdAt     DateTime @default(now())

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
  @@index([seasonId])
}

model MarketValue {
  id          String @id

  playerId    String

  value       Int
  capturedAt  DateTime @default(now())

  player      Player @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@index([capturedAt])
}

model Injury {
  id              String @id

  playerId        String

  description     String?
  startDate       DateTime?
  expectedReturn  DateTime?

  player          Player @relation(fields: [playerId], references: [id])

  createdAt       DateTime @default(now())

  @@index([playerId])
}

model SyncLog {
  id          String @id @default(cuid())

  type        String
  status      String

  records     Int?

  error       String?

  startedAt   DateTime @default(now())
  completedAt DateTime?
}