generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id        String   @id
  name      String
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clubs     Club[]
}

model Club {
  id                String     @id
  name              String
  slug              String     @unique
  logoUrl           String?
  leagueId          String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  league            League     @relation(fields: [leagueId], references: [id])
  players           Player[]
  outgoingTransfers Transfer[] @relation("OutgoingTransfers")
  incomingTransfers Transfer[] @relation("IncomingTransfers")

  @@index([leagueId])
}

model Player {
  id            String        @id
  name          String
  position      String?
  nationality   String?
  dateOfBirth   DateTime?
  currentClubId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  injuries      Injury[]
  MarketValue   MarketValue[]
  currentClub   Club?         @relation(fields: [currentClubId], references: [id])
  transfers     Transfer[]

  @@index([currentClubId])
}

model Transfer {
  id           String    @id
  playerId     String
  fromClubId   String?
  toClubId     String?
  seasonId     String
  fee          Int?
  transferDate DateTime?
  transferType String?
  createdAt    DateTime  @default(now())
  fromClub     Club?     @relation("OutgoingTransfers", fields: [fromClubId], references: [id])
  player       Player    @relation(fields: [playerId], references: [id])
  Season       Season    @relation(fields: [seasonId], references: [id])
  toClub       Club?     @relation("IncomingTransfers", fields: [toClubId], references: [id])

  @@index([fromClubId])
  @@index([playerId])
  @@index([seasonId])
  @@index([toClubId])
}

model Injury {
  id             String    @id
  playerId       String
  description    String?
  startDate      DateTime?
  expectedReturn DateTime?
  createdAt      DateTime  @default(now())
  player         Player    @relation(fields: [playerId], references: [id])

  @@index([playerId])
}

model SyncLog {
  id          String    @id @default(cuid())
  type        String
  status      String
  records     Int?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model MarketValue {
  id         String   @id
  playerId   String
  value      Int
  capturedAt DateTime @default(now())
  Player     Player   @relation(fields: [playerId], references: [id])

  @@index([capturedAt])
  @@index([playerId])
}

model Season {
  id        String     @id
  name      String
  startYear Int
  endYear   Int
  createdAt DateTime   @default(now())
  Transfer  Transfer[]
}
