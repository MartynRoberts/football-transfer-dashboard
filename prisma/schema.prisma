generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model League {
  id              String   @id @default(cuid())
  transfermarktId String?  @unique
  name            String
  country         String?
  slug            String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clubs           Club[]
}

model Club {
  id                String     @id @default(cuid())
  transfermarktId   String?    @unique
  name              String
  slug              String     @unique
  logoUrl           String?
  leagueId          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  league            League?    @relation(fields: [leagueId], references: [id])
  syncEnabled       Boolean    @default(false)
  players           Player[]
  outgoingTransfers Transfer[] @relation("OutgoingTransfers")
  incomingTransfers Transfer[] @relation("IncomingTransfers")

  @@index([leagueId])
}

model Player {
  id              String        @id @default(cuid())
  transfermarktId String?       @unique
  slug            String        @unique
  name            String
  imageUrl        String?
  position        String?
  nationality     String?
  dateOfBirth     DateTime?
  foot            String?
  height          Int?
  contract        DateTime?
  joinedOn        DateTime?
  currentClubId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  injuries        Injury[]
  marketValues    MarketValue[] @relation("PlayerMarketValues")
  currentClub     Club?         @relation(fields: [currentClubId], references: [id])
  transfers       Transfer[]

  marketValue          Int?
  worldwideRank        Int?
  leagueRank           Int?
  clubRank             Int?
  positionRank         Int?
  marketValueHistories MarketValueHistory[] @relation("PlayerMarketValueHistory")

  @@index([currentClubId])
}

model Season {
  id        String     @id @default(cuid())
  name      String     @unique
  startYear Int
  endYear   Int
  createdAt DateTime   @default(now())
  transfers Transfer[]
}

model Transfer {
  id              String    @id @default(cuid())
  transfermarktId String?   @unique
  playerId        String
  fromClubId      String?
  toClubId        String?
  seasonId        String?
  fee             Int?
  marketValue     Int?
  upcoming        Boolean   @default(false)
  transferDate    DateTime?
  transferType    String?
  createdAt       DateTime  @default(now())
  fromClub        Club?     @relation("OutgoingTransfers", fields: [fromClubId], references: [id])
  player          Player    @relation(fields: [playerId], references: [id])
  season          Season?   @relation(fields: [seasonId], references: [id])
  toClub          Club?     @relation("IncomingTransfers", fields: [toClubId], references: [id])

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
  @@index([seasonId])
}

model MarketValue {
  id         String   @id @default(cuid())
  playerId   String
  value      Int
  capturedAt DateTime @default(now())

  player Player @relation("PlayerMarketValues", fields: [playerId], references: [id])

  @@index([playerId])
  @@index([capturedAt])
}

model MarketValueHistory {
  id String @id

  playerId String

  date DateTime
  age  Int?

  marketValue Int

  clubName String?

  player Player @relation("PlayerMarketValueHistory", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([date])
}

model Injury {
  id       String @id
  playerId String

  season      String?
  description String

  startDate      DateTime
  expectedReturn DateTime?

  days        Int?
  gamesMissed Int?

  player Player @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())
}

model SyncLog {
  id             String    @id @default(cuid())
  type           String
  status         String
  recordsCreated Int       @default(0)
  recordsUpdated Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
}
